{
  "entities": {
    "Feedback": {
      "title": "Feedback",
      "description": "User suggestions and bug reports.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["suggestion", "bug"],
          "description": "Type of feedback."
        },
        "content": {
          "type": "string",
          "description": "The detailed feedback content."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email of the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time the feedback was submitted."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "resolved"],
          "description": "Status of the feedback."
        }
      },
      "required": ["type", "content", "createdAt"]
    },
    "QuestionRegistry": {
      "title": "QuestionRegistry",
      "description": "Registered questions and their correct answers.",
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "The exact question text."
        },
        "type": {
          "type": "string",
          "enum": ["MULTIPLE_CHOICE", "OPEN_ENDED"],
          "description": "Type of the question."
        },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Options for multiple choice."
        },
        "correctAnswer": {
          "type": "integer",
          "description": "0-based index of correct answer."
        },
        "suggestedAnswer": {
          "type": "string",
          "description": "Suggested answer for open ended questions."
        },
        "explanation": {
          "type": "string",
          "description": "Explanation of the correct answer."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the question was registered."
        }
      },
      "required": ["question", "type", "explanation", "createdAt"]
    },
    "EvaluatedAnswer": {
      "title": "EvaluatedAnswer",
      "description": "Cached evaluation of an open-ended student answer for consistency.",
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "maxLength": 5000,
          "description": "The open-ended question text."
        },
        "userAnswer": {
          "type": "string",
          "maxLength": 5000,
          "description": "The student's submitted answer."
        },
        "score": {
          "type": "integer",
          "description": "Evaluated score from 0 to 100."
        },
        "feedback": {
          "type": "string",
          "maxLength": 5000,
          "description": "Constructive feedback for the student."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the answer was evaluated."
        }
      },
      "required": ["question", "userAnswer", "score", "feedback", "createdAt"]
    }
  },
  "firestore": {
    "feedback": {
      "schema": "Feedback",
      "description": "Collection for storing user feedback."
    },
    "questions_registry/{questionId}": {
      "schema": "QuestionRegistry",
      "description": "Collection of globally registered questions and answers."
    },
    "evaluated_answers/{answerId}": {
      "schema": "EvaluatedAnswer",
      "description": "Collection of cached open-ended answer evaluations."
    }
  }
}
