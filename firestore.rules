rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    
    // Feedback specific validation
    function isValidFeedback(data) {
      return data.keys().hasAll(['type', 'content', 'createdAt', 'status']) &&
             data.keys().size() == 4 &&
             data.type in ['suggestion', 'bug'] &&
             data.content is string && data.content.size() <= 5000 &&
             data.createdAt == request.time &&
             data.status == 'pending';
    }

    // Question Registry specific validation
    function isValidQuestion(data) {
      return data.keys().hasAll(['question', 'type', 'explanation', 'createdAt']) &&
             data.question is string && data.question.size() <= 5000 &&
             data.type in ['MULTIPLE_CHOICE', 'OPEN_ENDED'] &&
             data.explanation is string && data.explanation.size() <= 5000 &&
             data.createdAt == request.time &&
             (!data.keys().hasAny(['options']) || (data.options is list && data.options.size() <= 10)) &&
             (!data.keys().hasAny(['correctAnswer']) || data.correctAnswer is int) &&
             (!data.keys().hasAny(['suggestedAnswer']) || (data.suggestedAnswer is string && data.suggestedAnswer.size() <= 5000));
    }

    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      // Only admins should read feedback. For now, we block public reads.
      allow read: if false; 
    }

    match /questions_registry/{questionId} {
      allow get: if isValidId(questionId);
      allow create: if isValidId(questionId) && isValidQuestion(request.resource.data);
      allow list, update, delete: if false;
    }
  }
}
